{
  "jobs": [
    {
      "functionLocation": "/badges/evaluate.js",
      "functionName": "nightlyBadgeSweep",
      "description": "Evaluate badges for all active members nightly",
      "executionConfig": {
        "cronExpression": "0 3 * * *",
        "dateInTimezone": "America/Mexico_City"
      }
    },
    {
      "functionLocation": "/buddy/match.js",
      "functionName": "runDailyMatching",
      "description": "Match waiting buddy requests (Days 1-3 of cycle)",
      "executionConfig": {
        "cronExpression": "0 9 1-3 * *",
        "dateInTimezone": "America/Mexico_City"
      }
    },
    {
      "functionLocation": "/buddy/lifecycle.js",
      "functionName": "checkInactivity",
      "description": "Check for inactive buddies and send nudges/rematch offers",
      "executionConfig": {
        "cronExpression": "0 10 * * *",
        "dateInTimezone": "America/Mexico_City"
      }
    },
    {
      "functionLocation": "/buddy/lifecycle.js",
      "functionName": "proposeCallSlots",
      "description": "Propose call slots for kickoff, mid-cycle and closing calls",
      "executionConfig": {
        "cronExpression": "0 8 3-5,14-16,28-30 * *",
        "dateInTimezone": "America/Mexico_City"
      }
    },
    {
      "functionLocation": "/buddy/lifecycle.js",
      "functionName": "resolveKeepSwap",
      "description": "Resolve keep/swap votes and carry pairs into new cycle",
      "executionConfig": {
        "cronExpression": "0 6 1 * *",
        "dateInTimezone": "America/Mexico_City"
      }
    }
  ]
}
